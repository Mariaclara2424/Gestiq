# Copie este arquivo para .env e preencha com os seus valores.
# O .env NUNCA deve ser enviado para o GitHub.

# Ambiente
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/gestiq

# Banco de dados (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestiq
DB_USER=root
DB_PASS=

# Google Calendar (OAuth)
# Baixe o seu credentials.json no Google Cloud Console e salve fora do repositório.
GOOGLE_CREDENTIALS_PATH=/caminho/para/credentials.json
GOOGLE_REDIRECT_URI=http://localhost/gestiq/callback_google.php

# Usado só pelo script php scripts/setup_admin.php
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
